{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>yuniruyuni/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "n8n Docker image in Nix config",
      "managerFilePatterns": [
        "/nixos/services/n8n\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>n8nio/n8n):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cloudflared version in GitHub Actions workflow",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "CLOUDFLARED_VERSION=\"(?<currentValue>[^\"]+)\"\\s*\\n\\s*curl -L \"https://github\\.com/(?<depName>cloudflare/cloudflared)/releases/download"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
