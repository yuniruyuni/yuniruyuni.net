{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>yuniruyuni/renovate-config"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "NixOS flake inputs (nixpkgs / agenix / yunirun). Merging deploys to the production VPS via apply-nixos, so keep them separate from other updates and review the NixOS Validate build before merging at a quiet time",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake inputs",
      "addLabels": [
        "nixos"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "n8n Docker image in Nix config",
      "managerFilePatterns": [
        "/nixos/services/n8n\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>n8nio/n8n):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "cloudflared version in GitHub Actions workflow",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "CLOUDFLARED_VERSION=\"(?<currentValue>[^\"]+)\"\\s*\\n\\s*curl -L \"https://github\\.com/(?<depName>cloudflare/cloudflared)/releases/download"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
